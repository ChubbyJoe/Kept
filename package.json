{
  "name": "kept",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "overrides": {
    "@serwist/next": {
      "browserslist": "4.29.0"
    }
  },
  "scripts": {
    "dev": "concurrently -p none 'serwist build --watch' 'next dev'",
    "dev:web": "next dev",
    "build": "next build --webpack && serwist build",
    "start": "next start",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run env:check && npm run log:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "env:check": "node --env-file-if-exists=.env.local src/platform/env/public.ts",
    "log:check": "node src/platform/logging/logger.ts",
    "commitlint": "commitlint --verbose",
    "prepare": "husky",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,md,mdx,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@serwist/cli": "9.5.12",
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "serwist": "9.5.12",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
